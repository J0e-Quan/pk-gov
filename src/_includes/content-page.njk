<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/assets/styles/global.css">
    <link rel="stylesheet" href={{ "/assets/styles/content-page.css" | url }}>
    <link rel="icon" href="/assets/favicons/generic.svg"/>
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" vite-ignore>
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    <title>{{ title }}</title>
  </head>
  <body>
   <div class='header-scrollable-area'>
     <header class="header">
        <a class="logo-text" href="/">
          <h3 class="logo-text top">Plushie Kingdom</h3>
          <h3 class="logo-text bottom">Government</h3>
        </a>
        <pagefind-searchbox class="search-desktop" shortcut="none" hide-shortcut placeholder="Search pk-gov..." show-sub-results=true></pagefind-searchbox>
        <div class="search-mobile">
          <img class="search-icon" src="../assets/icons/search.svg" alt="search icon">
          <pagefind-modal class="mobile-modal">
            <pagefind-modal-header>
              <pagefind-input placeholder="Search pk-gov..."></pagefind-input>
            </pagefind-modal-header>
     
            <pagefind-modal-body>
              <pagefind-summary></pagefind-summary>
              <pagefind-results></pagefind-results>
            </pagefind-modal-body>
          </pagefind-modal>
        </div>
      </header>
      <main data-pagefind-body>
        <section class="hero">
          {% if date %}
            <p class="hero-date">{{ date | postDate }}, by {{ author }}</p>
          {% endif %}
          <h1 class="hero-title">{{ title }}</h1>
          <p class="hero-excerpt">{{ excerpt | safe }}</p>
          {% if thumbnail %}
            <img class="hero-thumbnail" src="{{ thumbnail }}", alt="{{ thumbnail-alt }}">
          {% endif %}
        </section>
        <section data-pagefind-ignore='all' class='table-of-contents-container'>
          <h2 class='table-of-contents-title'>In this page:</h2>
          <hr>
          <div class='table-of-contents'></div>
        </section>
        <section class="page">
          {{ content | safe }}
        </section>
      </main>
      <div class="end-buttons">
        {% if tags != 'about' %}
          <button type="button" class="share">Share page</button>
        {% endif %}
        <button type="button" class="print">Print page</button>
        {% if tags == 'news' %}
          <a class="return" href="/news/">Return to news list</a>
        {% elif tags == 'info' or tags == 'about' %}
          <a class="return" href="/">Return to homepage</a>
        {% endif %}
      </div>
   </div>
    <footer class="footer">
      <section>
        <h3 class="footer-title">Ministries</h3>
        <hr>
        <div class="footer-links-list">
          <a class="footer link" href="/ministries/central/">Central Ministry</a>
          <a class="footer link" href="/ministries/food/">Ministry of Food</a>
          <a class="footer link" href="/ministries/foreign-affairs/">Ministry of Foreign Affairs</a>
          <a class="footer link" href="/ministries/health/">Ministry of Health</a>
          <a class="footer link" href="/ministries/finance/">Ministry of Finance</a>
          <a class="footer link" href="/ministries/immigration/">Ministry of Immigration</a>
          <a class="footer link" href="/ministries/technology/">Ministry of Technology</a>
          <a class="footer link" href="/ministries/defence/">Ministry of Defence</a>
        </div>
      </section>
      <section>
        <h3 class="footer-title">Information</h3>
        <hr>
        <div class="footer-links-list">
          <a class="footer link" href="/info/who-we-are/">Who we are</a>
          <a class="footer link" href="/info/travelling-in-and-out/">Travelling in and out</a>
          <a class="footer link" href="/news/">Government news</a>
          <a class="footer link" href="/info/safety-and-residency/">Safety and Residency</a>
          <a class="footer link" href="/info/food-health-and-wealth/">Food, Health and Wealth</a>
          <a class="footer link" href="/info/business-and-commerce/">Business and Commerce</a>
        </div>
      </section>
      <section>
        <h3 class="footer-title">Services</h3>
        <hr>
        <div class="footer-links-list">
          <a class="footer link" href="/start/pibss/">PIBSS</a>
          <a class="footer link" href="/start/weather/">Plushie Kingdom weather</a>
          <a class="footer link" href="/start/timeline/">Timeline</a>
        </div>
      </section>
      <section>
        <h3 class="footer-title">About us</h3>
        <hr>
        <div class="footer-links-list">
          <a class="footer link" href="/about/pk-gov/">About the pk-gov website</a>
          <a class="footer link" href="/info/who-we-are/#history-of-the-plushie-kingdom"
            >History of the Plushie Kingdom</a
          >
          <a class="footer link" href="/about/gov-identity/">Government identity guidelines</a>
        </div>
      </section>
    </footer>
    <script type='module' src="/global.js">
  </body>
</html>
